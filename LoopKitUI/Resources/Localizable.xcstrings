    "Some users choose a value 2, 3, or 4 times their highest scheduled basal rate." : {
      "comment" : "Information about typical maximum basal rates",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some users choose a value 2, 3, or 4 times their highest scheduled basal rate."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nogle brugere vælger en værdi 2, 3 eller 4 gange deres højeste basalrate."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Benutzer wählen einen Wert, der dem 2-, 3- oder 4-fachen ihrer höchsten geplanten Basalrate entspricht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos usuarios eligen un valor 2, 3 o 4 veces su tasa basal programada más alta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Useimmat käyttäjät valitsevat omaa korkeinta basaalitasoa 2, 3 tai 4 kertaa suuremman arvon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains utilisateurs choisissent une valeur 2, 3 ou 4 fois supérieure à leur débit basal programmé le plus élevé."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some users choose a value 2, 3, or 4 times their highest scheduled basal rate."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Some users choose a value 2, 3, or 4 times their highest scheduled basal rate."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni utenti scelgono un valore pari a 2, 3 o 4 volte la velocità basale pianificata massima."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noen brukere velger en verdi 2, 3 eller 4 ganger den høyeste planlagte basaldosen."
          }
        },
        "nl" : {
