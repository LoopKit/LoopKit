    "Changes will only apply this time you enable the override. The default settings of %@ will not be affected." : {
      "comment" : "Footer text for customizing an override from a preset (1: preset name)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Changes will only apply this time you enable the override. The default settings of %@ will not be affected."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ændringer gælder kun ved denne Override. Standardindstillingerne af %@ bliver ikke påvirket."
