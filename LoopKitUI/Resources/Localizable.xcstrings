    "Temporarily raise your glucose target before, during, or after physical activity to reduce the risk of low glucose events." : {
      "comment" : "Description of workout mode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily raise your glucose target before, during, or after physical activity to reduce the risk of low glucose events."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hæver midlertidigt dit blodsukkermål før, under eller efter fysisk aktivitet for at reducere risikoen for lavt blodsukker."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erhöhe Dein Blutzuckerziel vorübergehend vor, während oder nach körperlicher Aktivität, um das Risiko von Ereignissen mit niedrigem Blutzucker zu verringern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aumente temporalmente su objetivo de glucosa antes, durante o después de la actividad física para reducir el riesgo de tener eventos de glucosa baja."
          }
        },
        "fi" : {
          "stringUnit" : {
