    "It can be set as low as %1$@. It can be set as high as %2$@." : {
      "comment" : "Guardrail info text format",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It can be set as low as %1$@. It can be set as high as %2$@."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det kan sættes så lavt som %1$@. Det kan sættes så højt som %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es kann auf %1$@ eingestellt werden. Es kann bis zu %2$@ eingestellt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se puede configurar tan bajo como %1$@. \nSe puede configurar tan alto como %2$@."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se voidaan asettaa alimmillaan %1$@ ja korkeimmillaan %2$@."
          }
