    "Your Basal Rate of insulin is the number of units per hour that you want to use to cover your background insulin needs." : {
      "comment" : "Information about basal rates",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Your Basal Rate of insulin is the number of units per hour that you want to use to cover your background insulin needs."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En basalrate, er det antal af enheder i timen, som du skal bruge for at dække dit basale insulinbehov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Basalrate ist die Anzahl der Einheiten pro Stunde, die Du verwenden möchtest, um Deinen Hintergrund-Insulinbedarf zu decken."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
