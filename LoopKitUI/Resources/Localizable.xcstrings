    "Temporarily lower your glucose target before a meal to impact post-meal glucose spikes." : {
      "comment" : "Description of pre-meal mode",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily lower your glucose target before a meal to impact post-meal glucose spikes."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sænker midlertidigt dit blodsukker mål før et måltid for at modvirke stigning i blodsukker efter måltidet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senke Deinen Blutzuckerziel vor einer Mahlzeit vorübergehend ab, um Blutzuckerspitzen nach der Mahlzeit auszugleichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduzca temporalmente su objetivo de glucosa antes de una comida para reducir los picos de glucosa después de las comidas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laske glukoositavoitetta väliaikaisesti ennen ateriaa vaikuttaaksesi aterian jälkeiseen glukoosin nousuun."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diminue temporairement votre cible de glycémie avant un repas pour influer sur les pics d'hyperglycémie post-repas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily lower your glucose target before a meal to impact post-meal glucose spikes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Temporarily lower your glucose target before a meal to impact post-meal glucose spikes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbassa temporaneamente il tuo target glicemico prima di un pasto per influenzare i picchi glicemici postprandiali."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reduser glukosemålet ditt midlertidig før et måltid for å påvirke glukosetoppene etter måltidet."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tijdelijk verlagen van je glucosedoel vóór de maaltijd om de kans op post-maaltijd glucosepieken te verkleinen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tymczasowo obniż docelowy poziom glukozy przed posiłkiem, aby ograniczyć gwałtowny wzrost glukozy po posiłku."
          }
        },
